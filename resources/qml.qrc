        <file alias="views/DetailsView.qml">../src/qml/views/DetailsView.qml</file>
        <file alias="views/PlayerView.qml">../src/qml/views/PlayerView.qml</file>
        <file alias="views/SettingsView.qml">../src/qml/views/SettingsView.qml</file>
        <file alias="views/ExtensionsRouteView.qml">../src/qml/views/ExtensionsRouteView.qml</file>
