    <qresource prefix="/icons">
        <file alias="activity.svg">icons/activity.svg</file>
        <file alias="animation.svg">icons/animation.svg</file>
        <file alias="cast.svg">icons/cast.svg</file>
        <file alias="close.svg">icons/close.svg</file>
